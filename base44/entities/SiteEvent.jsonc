{
  "name": "SiteEvent",
  "type": "object",
  "public_permissions": {
    "create": true
  },
  "properties": {
    "event_type": {
      "type": "string"
    },
    "page": {
      "type": "string"
    },
    "element": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "lang": {
      "type": "string",
      "enum": [
        "pt",
        "en"
      ]
    },
    "device": {
      "type": "string"
    },
    "referrer": {
      "type": "string"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "extra_data": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}